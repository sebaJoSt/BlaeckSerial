# Only the clangd extension reads this file. The Microsoft C/C++ extension
# (ms-vscode.cpptools) ignores it and reads .vscode/c_cpp_properties.json instead,
# which is gitignored - so on a fresh checkout that one has to be written by hand.
#
# Either way the fix is the same: point the editor at a compilation database, so
# types like Stream and __FlashStringHelper resolve. Without one a hover reads
#
#   BlaeckBeginRef begin(<error type> *Ref, unsigned int Size)
#
# and the overloads in signature help are hard to tell apart, which is the one
# place the per-overload documentation is meant to be read.
#
# Generate the database - one line, so it pastes into PowerShell and bash alike:
#
#   arduino-cli compile --fqbn arduino:avr:mega --only-compilation-database --build-path "$PWD/.development/ccdb" examples/WaveformGenerator
#
# It is machine-specific (absolute paths, one board) and gitignored. Rebuild it
# after switching boards or adding a library; a stale one is not an error, the
# editor just falls back to guessing.
#
# The database covers the one sketch it was built from. Every other file falls back
# to whatever include paths the editor was given, and those must include the avr-gcc
# toolchain's own headers - not just the Arduino core:
#
#   <arduino15>/packages/arduino/tools/avr-gcc/<ver>/avr/include
#   <arduino15>/packages/arduino/tools/avr-gcc/<ver>/lib/gcc/avr/<ver>/include
#   <arduino15>/packages/arduino/hardware/avr/<ver>/libraries/*/src   (EEPROM and friends)
#
# Arduino.h includes <avr/pgmspace.h> on its 28th line. Miss that path and the include
# fails, every type after it is unknown, and one sketch reports ninety-odd problems.
#
# What no configuration fixes: a sketch calls functions defined further down the file,
# and the Arduino build inserts the prototypes. An editor reading the raw .ino as C++
# does not, so each example reports one "was not declared in this scope". The extra
# .ino files of a multi-file sketch are worse - they are appended to the main one at
# build time and have no includes of their own.
CompileFlags:
  CompilationDatabase: .development/ccdb
