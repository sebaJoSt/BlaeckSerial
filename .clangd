# Points clangd at the Arduino core, so types like Stream and __FlashStringHelper
# resolve. Without it a hover reads "begin(<error type> *Ref, ...)": clangd is
# parsing the header with no core on the include path, so every Arduino type is
# unknown and overloads are hard to tell apart.
#
# The database is generated, machine-specific (absolute paths, one board), and
# gitignored. Rebuild it after changing boards or adding a library:
#
#   arduino-cli compile --fqbn arduino:avr:mega --only-compilation-database \
#       --build-path "$PWD/.development/ccdb" examples/WaveformGenerator
#
# Then restart the language server: Ctrl+Shift+P, "clangd: Restart language server".
CompileFlags:
  CompilationDatabase: .development/ccdb
